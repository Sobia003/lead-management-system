    {
      "parameters": {
        "operation": "get",
        "dataTableId": {
          "__rl": true,
          "value": "YOUR_N8N_DATA_TABLE_ID",
          "mode": "list",
          "cachedResultName": "YOUR_DATA_TABLE_NAME"
        },
        "filters": {
          "conditions": [
            {
              "keyName": "lead_type",
              "keyValue": "=E-commerce"
            }
          ]
        }
      },
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1.1,
      "position": [
        848,
        -16
      ],
      "id": "aa429d8c-d7a8-4294-b5c9-91c26d0d46cc",
      "name": "assign_salesperson"
    },
    {
      "parameters": {
        "authentication": "appToken",
        "resource": "deal",
        "stage": "qualifiedtobuy",
        "additionalFields": {
          "associatedVids": "={{ [ $('Create_contact').item.json.vid ] }}",
          "dealName": "={{ $('Webhook').item.json.body.company }} - {{ $('Webhook').item.json.body.message }}",
          "dealOwner": {
            "__rl": true,
            "mode": "id",
            "value": "YOUR_HUBSPOT_OWNER_ID"
          }
        }
      },
      "type": "n8n-nodes-base.hubspot",
      "typeVersion": 2.2,
      "position": [
        1056,
        -16
      ],
      "id": "68f63caa-af6a-41b4-aea9-330c066494e8",
      "name": "Create_deal"
    },
    {
      "parameters": {
        "fromEmail": "YOUR_SENDER_EMAIL",
        "toEmail": "YOUR_SALES_TEAM_EMAIL",
        "subject": "New Lead Assigned to You",
        "html": "=<h3>New Lead Assigned</h3>\n\n<p>Hello,</p>\n\n<p>A new lead has been assigned to you.</p>\n\n<p><strong>Deal:</strong> {{ $json.properties.dealname.value }}</p>\n\n<p><strong>Deal ID:</strong> {{ $json.dealId }}</p>\n\n<p>Please follow up with the lead.</p>",
        "options": {}
      },
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [
        1280,
        224
      ],
      "id": "6f02ca36-12d6-4f8e-af43-15f2056a5792",
      "name": "Email_salesperson"
    },
    {
      "parameters": {
        "fromEmail": "YOUR_SENDER_EMAIL",
        "toEmail": "={{ $('Webhook').item.json.body.email }}",
        "subject": "We received your request",
        "html": "=<p>Hi {{ $('Webhook').item.json.body.name }},</p>\n\n<p>Thank you for contacting us.</p>\n\n<p>We received your request for an e-commerce website and our team will get back to you shortly.</p>\n\n<p>Best regards,<br>Sales Team</p>",
        "options": {}
      },
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [
        1264,
        -16
      ],
      "id": "cde6321f-758d-4096-ad3e-5b96608bfc89",
